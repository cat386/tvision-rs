{
  "tvcreator": 1,
  "name": "KeypadDialog",
  "title": "Код доступа",
  "kind": "dialog",
  "size": [30, 16],
  "auto_size": true,
  "command_base": 120,
  "layout": {
    "type": "grid",
    "columns": 3,
    "margins": [1, 1, 1, 0],
    "items": [
      {"type": "input", "name": "code", "max_len": 8, "span": [1, 3]},
      {"type": "button", "name": "k1", "text": "1", "command": "CM_KEY1", "expand": true},
      {"type": "button", "name": "k2", "text": "2", "command": "CM_KEY2", "expand": true},
      {"type": "button", "name": "k3", "text": "3", "command": "CM_KEY3", "expand": true},
      {"type": "button", "name": "k4", "text": "4", "command": "CM_KEY4", "expand": true},
      {"type": "button", "name": "k5", "text": "5", "command": "CM_KEY5", "expand": true},
      {"type": "button", "name": "k6", "text": "6", "command": "CM_KEY6", "expand": true},
      {"type": "button", "name": "k0", "text": "0", "command": "CM_KEY0", "expand": true, "span": [1, 2]},
      {"type": "button", "name": "enter", "text": "O~K~", "command": "OK", "default": true, "expand": true}
    ]
  }
}
